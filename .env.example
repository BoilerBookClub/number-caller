VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional. Defaults to the Boiler Book Club Discord application.
VITE_DISCORD_CLIENT_ID=your-discord-oauth-client-id

# Optional. Set to collect client crash reports from a live event.
VITE_ERROR_REPORT_URL=

# Optional. reCAPTCHA v3 site key from Firebase console -> App Check.
# Setting this makes the client send attestation tokens. Enforcement is a
# separate step (ENFORCE_APP_CHECK in functions/.env).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Set to true to run against the local emulator suite (npm run emulators).
VITE_USE_FIREBASE_EMULATORS=false
