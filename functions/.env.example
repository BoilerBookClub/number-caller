# Optional Cloud Functions configuration. Copy to functions/.env to override.
# functions/.env is gitignored.
#
# DISCORD_BOT_TOKEN is NOT set here — it lives in Secret Manager:
#   npx firebase-tools functions:secrets:set DISCORD_BOT_TOKEN
# Without it, staff "Refresh membership" cannot re-check Discord and falls back
# to the roles cached in each user's Firebase token.
#
# DISCORD_CLIENT_SECRET likewise, and login does not work at all without it:
#   npx firebase-tools functions:secrets:set DISCORD_CLIENT_SECRET
# It is the OAuth client secret from the Discord application's OAuth2 page, and
# is what turns the authorization code the browser receives into an access
# token. Copy it from the same page that shows VITE_DISCORD_CLIENT_ID.

# Optional. Default to the Boiler Book Club guild and roles.
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_STAFF_ROLE_IDS=

# The OAuth application logins are exchanged against. Has to match the client's
# VITE_DISCORD_CLIENT_ID and the app that owns DISCORD_CLIENT_SECRET. Defaults
# in code to the Boiler Book Club app.
#
# Setting one of the pair without the other is the failure worth knowing about:
# the browser authorizes against one application and this function presents
# another, so every login fails at once with nothing but a generic "Discord
# login failed" to go on. The deploy workflow writes this from the same value it
# builds VITE_DISCORD_CLIENT_ID from, so the two cannot drift apart in CI.
DISCORD_CLIENT_ID=

# Optional allowlist of redirect URIs the login exchange will accept, comma
# separated (e.g. https://example.web.app/). Empty means "any valid https URI",
# which is safe because Discord independently rejects redirect URIs that are not
# registered on the application. Set it if you want a second fence.
DISCORD_REDIRECT_URIS=

# How many instances of the three attendee callables stay warm.
#
# 0 outside an event, which is the default, because this bills whether or not
# anything is running. Set it to 2 on the day: those callables are sized for a
# whole CPU so they serve 20 requests each, but a cold container start still
# lands on whoever is first through the door, and at an event the first people
# through the door all arrive together.
#
# Put it back to 0 afterwards.
ATTENDEE_MIN_INSTANCES=0

# App Check enforcement. Only set to true AFTER the client is sending tokens
# (VITE_FIREBASE_APPCHECK_SITE_KEY) and the Firebase console shows verified
# requests — otherwise every callable starts rejecting and the event stops.
ENFORCE_APP_CHECK=false

# Comma-separated origins allowed to POST crash reports. When empty this falls
# back to the project's own {project}.web.app / {project}.firebaseapp.com
# origins — not to "any origin", which is what it used to mean.
ERROR_REPORT_ALLOWED_ORIGINS=

# Comma-separated Discord user IDs that get staff access regardless of guild
# roles. Bootstrap for the chicken-and-egg problem of needing staff access to
# run an event but needing someone else to grant you the role first. There is no
# code default — leaving this empty means guild roles are the only way in.
DISCORD_STAFF_USER_IDS=
